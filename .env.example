# Unlocks premium-tier features in development builds.
# Set to "true" in your local .env.local to bypass the paywall while working
# on gated screens. MUST stay "false" (or unset) in any production/preview
# build — the subscription default respects this flag at runtime.
EXPO_PUBLIC_DEV_PREMIUM=false

# BioDigital Human 3D anatomy widget API key.
# 1. Register a free developer account: https://developer.biodigital.com
# 2. Create an app and copy the "Developer Key" (not the secret).
# 3. Paste it below in .env.local — NEVER commit the key.
# When empty, the 3D tab falls back to the placeholder WebView.
EXPO_PUBLIC_BIODIGITAL_API_KEY=
