# Unlocks premium-tier features in development builds.
# Set to "true" in your local .env.local to bypass the paywall while working
# on gated screens. MUST stay "false" (or unset) in any production/preview
# build — the subscription default respects this flag at runtime.
EXPO_PUBLIC_DEV_PREMIUM=false

# Switches the 3D tab between the legacy planar viewer and the new mesh-based
# PoC built on @react-three/fiber/native. Set to "true" only in dev to validate
# that GLB models load correctly on device. MUST stay "false" in production
# until Fase 1+ of agent_docs/plans/3d-realistic-mesh-viewer.md ships.
EXPO_PUBLIC_3D_POC=false
